{"file":"about-CtF4Xd_K.js","mappings":";;;;;;;;;;;;;;;;;;;;;;AAGA,UAAM,UAAU,IAAI,CAAC;AACrB,UAAM,KAAK,IAAwB,IAAI;;;iBAoC3B;AAAA,QAAJ,KAAI;AAAA,MAAA,8BAAQA,MAAA,OAAA,CAAO,mBAAM,QAAA,MAAM;;;;;;;;;;;;;;ACvCvC,eAAW;AAAA,MACT,OAAO;AAAA,MACP,aACE;AAAA,MACF,SAAS;AAAA,MACT,eAAe;AAAA,MACf,OAAO;AAAA,IAAA,CACR;AAED,YAAQ;AAAA,MACN,MAAM,CAAC,EAAE,KAAK,aAAa,MAAM,yCAAyC;AAAA,IAAA,CAC3E;AAED,UAAM,UAAU;AAAA,MACd,EAAE,OAAO,oBAAoB,OAAO,GAAG,QAAQ,GAAA;AAAA,MAC/C,EAAE,OAAO,sBAAsB,OAAO,GAAG,QAAQ,GAAA;AAAA,MACjD,EAAE,OAAO,sBAAsB,OAAO,GAAG,QAAQ,GAAA;AAAA,MACjD,EAAE,OAAO,oBAAoB,OAAO,IAAI,QAAQ,GAAA;AAAA,IAAG;AAGrD,UAAM,UAAU;AAAA,MACd;AAAA,QACE,QAAQ;AAAA,QACR,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,QAAQ;AAAA,QACR,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,QAAQ;AAAA,QACR,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,QAAQ;AAAA,QACR,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,QAAQ;AAAA,QACR,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,QAAQ;AAAA,QACR,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,IACR;AAGF,UAAM,SAAS;AAAA,MACb;AAAA,QACE,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,MAER;AAAA,QACE,OAAO;AAAA,QACP,MAAM;AAAA,MAAA;AAAA,IACR;AAGF,UAAM,qBAAqB;AAAA,MACzB;AAAA,MACA;AAAA,MACA;AAAA,MACA;AAAA,MACA;AAAA,IAAA;;;;;AAKS,YAAA,WAAAC,eAAAC,WAAA,EAAA,OAAM,0BAAsB,MAAA,CAAA,CAAA,g/BAAA;oBA0Bd,SAAO,CAAhB,GAAG,MAAC;;UACX,KAAK,EAAE;AAAA,UAEP,SAAS,EAAA,SAAA,GAAA,GAAA,GAAA;AAAA,UACT,wEAAsE,IAAC,MAAA;AAAA,UACxE,OAAM;AAAA,QAAA;;UAGY,QAAQ,EAAE;AAAA,UAAQ,QAAQ,EAAE;AAAA,QAAA;AAEJ,cAAA,8CAAAC,eAAA,EAAE,KAAK,CAAA,YAAA;AAAA;;oBAS3B,SAAO,CAAnB,MAAM,MAAC;;UACd,KAAK,KAAK;AAAA,UAEV,SAAS,EAAA,SAAA,GAAA,GAAA,IAAA;AAAA,UACT,wEAAsE,IAAC,MAAA;AAAA,UACxE,OAAM;AAAA,QAAA,0LAGqBA,eAAA,KAAK,MAAM,gDACKA,eAAA,KAAK,KAAK,oDACPA,eAAA,KAAK,IAAI;;;oBAQrC,QAAM,CAAlB,MAAM,MAAC;;UACd,KAAK,KAAK;AAAA,UACV,WAAW;AAAA,UAEX,SAAS,EAAA,SAAA,GAAA,GAAA,GAAA;AAAA,UACT,wEAAsE,IAAC,MAAA;AAAA,QAAA;2BAN1E,CAUW,GAAAC,QAAAC,UAAA,aAAA;;2EAFkCF,eAAA,KAAK,KAAK,sDAChBA,eAAA,KAAK,IAAI;;;gBAD9CG,YAA6D,QAAzD,OAAM,8BAAA,GAA6BC,gBAAI,KAAK,KAAK,GAAA,CAAA;AAAA,gBACrDD,YAAqD,OAAlD,OAAM,yBAAA,GAAwBC,gBAAI,KAAK,IAAI,GAAA,CAAA;AAAA,cAAA;AAAA;;;;;;AAO9BC,oBAAA,qBAAT,UAAK;8HAIT,KAAK,CAAA,OAAA;AAAA;;;;;;;;;;;","names":["_unref","_ssrRenderAttrs","_mergeProps","_ssrInterpolate","_push","_parent","_createVNode","_toDisplayString","_ssrRenderList"],"sources":["../../../../components/MetricCounter.vue","../../../../pages/about.vue"],"sourcesContent":["<script setup lang=\"ts\">\nconst props = defineProps<{ target: number; suffix?: string; duration?: number }>();\n\nconst display = ref(0);\nconst el = ref<HTMLElement | null>(null);\nlet observer: IntersectionObserver | null = null;\nlet hasAnimated = false;\n\nfunction animate() {\n  const duration = props.duration ?? 1200;\n  const start = performance.now();\n\n  function tick(now: number) {\n    const elapsed = now - start;\n    const progress = Math.min(elapsed / duration, 1);\n    const eased = 1 - Math.pow(1 - progress, 3);\n    display.value = Math.round(props.target * eased);\n    if (progress < 1) requestAnimationFrame(tick);\n  }\n\n  requestAnimationFrame(tick);\n}\n\nonMounted(() => {\n  observer = new IntersectionObserver(\n    ([entry]) => {\n      if (entry.isIntersecting && !hasAnimated) {\n        hasAnimated = true;\n        animate();\n      }\n    },\n    { threshold: 0.4 }\n  );\n  if (el.value) observer.observe(el.value);\n});\n\nonUnmounted(() => observer?.disconnect());\n</script>\n\n<template>\n  <span ref=\"el\">{{ display }}{{ suffix }}</span>\n</template>","<script setup lang=\"ts\">\nuseSeoMeta({\n  title: \"About — Ludwig Maingi\",\n  description:\n    \"Self-taught backend and systems engineer. Building multi-tenant SaaS, e-commerce platforms, database architectures, and APIs — remote-first, worldwide.\",\n  ogTitle: \"About — Ludwig Maingi\",\n  ogDescription: \"Self-taught backend and systems engineer. Remote-first, worldwide.\",\n  ogUrl: \"https://ludwigmaingi.vercel.app/about\"\n});\n\nuseHead({\n  link: [{ rel: \"canonical\", href: \"https://ludwigmaingi.vercel.app/about\" }]\n});\n\nconst metrics = [\n  { label: \"Projects Shipped\", value: 7, suffix: \"\" },\n  { label: \"Auth Systems Built\", value: 4, suffix: \"\" },\n  { label: \"Databases Designed\", value: 5, suffix: \"\" },\n  { label: \"Products Shipped\", value: 11, suffix: \"\" }\n];\n\nconst journey = [\n  {\n    period: \"Getting started\",\n    title: \"Started programming, self-taught, on Android\",\n    body: \"Termux and Acode from day one — a constraint that shaped every toolchain decision since: lean setups, no native binaries, explicit code over hidden abstractions.\"\n  },\n  {\n    period: \"First full build\",\n    title: \"Built Taskr\",\n    body: \"A MEVN-stack task manager, taken through a full audit and made production-ready — the first project that forced real decisions about structure, not just following a tutorial.\"\n  },\n  {\n    period: \"First real client\",\n    title: \"Shipped Joy Agency\",\n    body: \"A staffing platform (Vue 3, Express, MongoDB, Cloudinary) built and deployed for a real client — resolving real production issues, not toy-project ones: CORS, SPA rewrites, upload failures.\"\n  },\n  {\n    period: \"Now\",\n    title: \"Designing Soko\",\n    body: \"A multi-tenant SaaS platform for commerce, TypeScript and raw PostgreSQL by design — no ORM, branded ID types, explicit transactions. Built from the inside: I worked inside informal market commerce, which is where the problem became real to me.\"\n  },\n  {\n    period: \"Products\",\n    title: \"Launched the Digital Product Suite\",\n    body: \"Extracted the production internals of Soko and Flemela into eleven standalone tools and SaaS kits — tested, documented, and shipped as digital products on Gumroad and Whop.\"\n  },\n  {\n    period: \"Ongoing\",\n    title: \"Deepening the fundamentals\",\n    body: \"Structured DSA study and distributed-systems concepts, anchored to Soko, Flemela, and the Digital Product Suite as real reference points rather than abstract exercises.\"\n  }\n];\n\nconst values = [\n  {\n    title: \"Correctness first\",\n    body: \"Constraints, types, and migrations come before performance work. Speed optimizations happen once the schema can be trusted.\"\n  },\n  {\n    title: \"Security\",\n    body: \"Refresh token rotation with reuse detection, not just access tokens with long lifespans — auth that assumes tokens will eventually leak, and plans for it.\"\n  },\n  {\n    title: \"Scalability\",\n    body: \"Indexing and schema decisions get made upfront, before the data volume that would expose a bad one — not retrofitted after a slow query shows up in production.\"\n  },\n  {\n    title: \"Maintainability\",\n    body: \"Snake_case types that mirror raw pg output, explicit transactions, no implicit any — so six months from now, the code still reads like what it actually does.\"\n  },\n  {\n    title: \"No ORM, on purpose\",\n    body: \"Raw pg and hand-written SQL keep query behavior visible and debuggable — no hidden N+1s from an abstraction layer deciding what to run.\"\n  },\n  {\n    title: \"Multi-tenancy from day one\",\n    body: \"Branded ID types (OrgId, UserId) make tenant isolation a compile-time concern, not a runtime hope.\"\n  }\n];\n\nconst architectureTopics = [\n  \"JWT auth with refresh token rotation\",\n  \"Role-based access control (RBAC)\",\n  \"Multi-tenant schema isolation\",\n  \"PostgreSQL indexing strategy\",\n  \"Caching and queue processing patterns\"\n];\n</script>\n\n<template>\n  <section class=\"container-page py-20\">\n    <p class=\"eyebrow mb-3\">About</p>\n    <h1 class=\"mb-8 text-display-lg font-display font-semibold text-ink\">My Story</h1>\n\n    <div class=\"markdown-body mb-16 max-w-2xl\">\n      <p>\n        I'm a self-taught fullstack developer working remote-first with clients and\n        teams worldwide. My background is in forex and\n        futures trading, which is where the technical-analysis habit of mind\n        came from — reading systems for risk before reading them for features.\n      </p>\n      <p>\n        I develop entirely on Android, using Termux and Acode. That constraint\n        has shaped how I build: lean toolchains, explicit code over heavy\n        abstractions, and a strong bias toward understanding exactly what's\n        running rather than trusting a framework to hide it from me.\n      </p>\n      <p>\n        Before this, I worked inside informal market commerce —\n        which is why commerce infrastructure is a focus rather than an afterthought.\n        I've seen the problem from the inside, and I build for it wherever it exists.\n      </p>\n    </div>\n\n    <div class=\"mb-16 grid grid-cols-2 gap-6 sm:grid-cols-4\">\n      <div\n        v-for=\"(m, i) in metrics\"\n        :key=\"m.label\"\n        v-motion\n        :initial=\"{ opacity: 0, y: 16 }\"\n        :visible-once=\"{ opacity: 1, y: 0, transition: { duration: 500, delay: i * 100 } }\"\n        class=\"text-center\"\n      >\n        <p class=\"text-3xl font-display font-semibold text-accent-bright sm:text-4xl\">\n          <MetricCounter :target=\"m.value\" :suffix=\"m.suffix\" />\n        </p>\n        <p class=\"mt-1 text-xs text-ink-muted\">{{ m.label }}</p>\n      </div>\n    </div>\n\n    <h2 class=\"mb-8 text-2xl font-semibold text-ink\">Engineering Journey</h2>\n    <div class=\"relative mb-16 pl-10\">\n      <div class=\"absolute bottom-1 left-[7px] top-1 w-px bg-border\" />\n      <ol class=\"space-y-10\">\n        <li\n          v-for=\"(step, i) in journey\"\n          :key=\"step.title\"\n          v-motion\n          :initial=\"{ opacity: 0, x: -16 }\"\n          :visible-once=\"{ opacity: 1, x: 0, transition: { duration: 500, delay: i * 150 } }\"\n          class=\"relative\"\n        >\n          <span class=\"absolute -left-10 top-0.5 h-4 w-4 rounded-full border-2 border-accent-bright bg-canvas\" />\n          <p class=\"eyebrow mb-1\">{{ step.period }}</p>\n          <h3 class=\"mb-1 font-semibold text-ink\">{{ step.title }}</h3>\n          <p class=\"max-w-xl text-sm text-ink-muted\">{{ step.body }}</p>\n        </li>\n      </ol>\n    </div>\n\n    <h2 class=\"mb-6 text-2xl font-semibold text-ink\">Engineering Values</h2>\n    <div class=\"mb-16 grid gap-5 sm:grid-cols-3\">\n      <BaseCard\n        v-for=\"(item, i) in values\"\n        :key=\"item.title\"\n        :hoverable=\"false\"\n        v-motion\n        :initial=\"{ opacity: 0, y: 24 }\"\n        :visible-once=\"{ opacity: 1, y: 0, transition: { duration: 600, delay: i * 100 } }\"\n      >\n        <h3 class=\"mb-2 font-semibold text-ink\">{{ item.title }}</h3>\n        <p class=\"text-sm text-ink-muted\">{{ item.body }}</p>\n      </BaseCard>\n    </div>\n\n    <h2 class=\"mb-6 text-2xl font-semibold text-ink\">Systems I Design For</h2>\n    <ul class=\"mb-16 grid gap-3 sm:grid-cols-2\">\n      <li\n        v-for=\"topic in architectureTopics\"\n        :key=\"topic\"\n        class=\"rounded-lg border border-border bg-canvas-raised px-4 py-3 text-sm text-ink-muted\"\n      >\n        {{ topic }}\n      </li>\n    </ul>\n\n    <h2 class=\"mb-6 text-2xl font-semibold text-ink\">Stack</h2>\n    <p class=\"max-w-2xl text-ink-muted\">\n      TypeScript, Node.js, Express, PostgreSQL (raw <code class=\"font-mono text-accent-bright\">pg</code>,\n      no ORM, by design), Nuxt, Neon, deployed to Render and Vercel.\n    </p>\n  </section>\n</template>"],"version":3}